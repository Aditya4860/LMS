@{
    Layout = null;
    ViewData["Title"] = "MPOnline - Next-Generation Citizen Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Custom Design System CSS -->
    <link rel="stylesheet" href="~/css/styles/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles/landing.css" asp-append-version="true" />
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        .landing-nav {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(247, 247, 247, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .hero-section {
            padding: 10rem 2rem 6rem;
            text-align: center;
            position: relative;
            overflow: hidden;
            background: radial-gradient(circle at 50% -20%, rgba(91, 124, 250, 0.15), transparent 60%);
        }
        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 1rem;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-pill);
            font-size: 0.875rem;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 2rem;
            box-shadow: var(--shadow-sm);
        }
        .hero-title {
            font-size: 4.5rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1.1;
            margin-bottom: 1.5rem;
            background: linear-gradient(135deg, #111111 0%, #4A65D1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .hero-subtitle {
            font-size: 1.25rem;
            color: var(--text-secondary);
            max-width: 600px;
            margin: 0 auto 3rem;
            line-height: 1.6;
        }
        .features-section {
            padding: 6rem 2rem;
            background: var(--card-bg);
            border-top: 1px solid var(--border-color);
        }
        .feature-card {
            padding: 2rem;
            text-align: left;
        }
        .feature-icon {
            width: 48px;
            height: 48px;
            background: rgba(91, 124, 250, 0.1);
            color: var(--accent-color);
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
        }
        .cta-section {
            padding: 8rem 2rem;
            text-align: center;
            background: var(--text-primary);
            color: #fff;
        }
        .cta-section h2 {
            color: #fff;
            font-size: 3rem;
            letter-spacing: -0.03em;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    
    <nav class="landing-nav animate-fade-in">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 36px; height: 36px; background: var(--text-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white;">
                <i data-lucide="book"></i>
            </div>
            <span style="font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em;">MPOnline</span>
        </div>
        <div style="display: flex; gap: 2rem; font-weight: 500; color: var(--text-secondary);">
            <a href="#features" style="color: inherit;">Features</a>
            <a href="#services" style="color: inherit;">Services</a>
            <a href="#about" style="color: inherit;">About</a>
        </div>
        <div style="display: flex; gap: 1rem;">
            <a href="/Account/Login" class="btn btn-secondary">Login</a>
            <a href="/Account/Register" class="btn btn-primary">Get Started</a>
        </div>
    </nav>

    <section class="hero-section animate-fade-in stagger-1">
        <div class="hero-badge hover-scale">
            <span style="display: block; width: 8px; height: 8px; border-radius: 50%; background: var(--accent-color);"></span>
            MPOnline v2.0 is now live
        </div>
        <h1 class="hero-title">Knowledge infrastructure<br/>for the modern world.</h1>
        <p class="hero-subtitle">
            Seamlessly access, manage, and discover millions of resources. A unified digital platform engineered for speed, reliability, and beauty.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center;">
            <a href="/Account/Login" class="btn btn-primary" style="padding: 1rem 2rem; font-size: 1rem;">
                Enter Portal <i data-lucide="arrow-right" style="width: 18px; margin-left: 8px;"></i>
            </a>
            <a href="#features" class="btn btn-secondary" style="padding: 1rem 2rem; font-size: 1rem;">
                Explore Features
            </a>
        </div>
    </section>

    <section id="features" class="features-section">
        <div class="container">
            <div style="text-align: center; margin-bottom: 4rem;">
                <h2 style="font-size: 2.5rem; letter-spacing: -0.03em;">Engineered for efficiency</h2>
                <p style="color: var(--text-secondary); max-width: 500px; margin: 1rem auto 0; font-size: 1.125rem;">
                    Everything you need to manage your library resources, encapsulated in one beautifully designed platform.
                </p>
            </div>
            
            <div class="row">
                <div class="col-md-4">
                    <div class="card feature-card">
                        <div class="feature-icon"><i data-lucide="search"></i></div>
                        <h3 style="font-size: 1.25rem;">Instant Search</h3>
                        <p style="font-size: 0.9375rem; margin-bottom: 0;">Locate any book, magazine, or newspaper instantly across our comprehensive catalog.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card feature-card">
                        <div class="feature-icon"><i data-lucide="zap"></i></div>
                        <h3 style="font-size: 1.25rem;">Lightning Fast</h3>
                        <p style="font-size: 0.9375rem; margin-bottom: 0;">Built on modern architecture, ensuring zero latency when borrowing or returning items.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card feature-card">
                        <div class="feature-icon"><i data-lucide="shield-check"></i></div>
                        <h3 style="font-size: 1.25rem;">Secure Identity</h3>
                        <p style="font-size: 0.9375rem; margin-bottom: 0;">Enterprise-grade security and role-based access control for students and administrators.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    
    <section class="cta-section">
        <div class="container">
            <h2>Ready to transform your library?</h2>
            <p style="color: rgba(255,255,255,0.7); font-size: 1.25rem; max-width: 600px; margin: 0 auto 3rem;">
                Join thousands of students and librarians utilizing MPOnline daily.
            </p>
            <a href="/Account/Login" class="btn btn-accent" style="padding: 1rem 2.5rem; font-size: 1rem; color: white !important;">
                Start Building Today
            </a>
        </div>
    </section>

    <footer style="padding: 4rem 2rem; background: var(--bg-color); border-top: 1px solid var(--border-color); text-align: center;">
        <div class="container">
            <div style="width: 32px; height: 32px; background: var(--text-primary); border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; color: white; margin-bottom: 1.5rem;">
                <i data-lucide="book" style="width: 16px; height: 16px;"></i>
            </div>
            <p style="color: var(--text-secondary); font-size: 0.875rem;">&copy; @DateTime.Now.Year MPOnline. All rights reserved.</p>
        </div>
    </footer>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
